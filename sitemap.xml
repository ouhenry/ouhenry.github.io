---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% if page.url == '/' or page.url == '/about/' or page.url == '/archive/' or page.url == '/topics/' %}<url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>{% endif %}{% endfor %}
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>{% endfor %}
</urlset>
